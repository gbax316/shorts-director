# Copy to .env (repo root) and fill in what you use.

# ElevenLabs — required for voice (tools/gen_voice.py); also powers
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=
# Voice defaults for every short (a beats.json "voice" block overrides per short).
# Empty = premade "Liam" on eleven_multilingual_v2.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# JSON, e.g. {"stability": 0.5, "similarity_boost": 0.8, "style": 0.2, "use_speaker_boost": true}
ELEVENLABS_VOICE_SETTINGS=
ELEVENLABS_TTS_FORMAT=mp3_44100_128
# Whisper model for the line check (tiny, base, small, medium).
WHISPER_MODEL=small

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=

# Generative video clips (tools/gen_clip.py): fal or kie.
CLIP_PROVIDER=fal
FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1.5/pro/image-to-video
# kie.ai: key at https://kie.ai/api-key; model id exactly as https://kie.ai/market spells it.
KIE_API_KEY=
KIE_VIDEO_MODEL=bytedance/seedance-2

# fal.ai — key at https://fal.ai/dashboard/keys (API scope is enough). Also used by bakeoff_clip.py.
FAL_KEY=
